Options -Indexes

# Only runtime endpoints may be invoked over HTTP. Maintenance runs privately.
<FilesMatch "(?i)^(?!(?:webhook|health|cron)\.php$).*\.(?:php[0-9]?|phtml|phar)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)(^\.|\.(?:log|sql|zip|bak|old|orig|save|ini|env|tar|gz|7z|swp)$|~$)">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

<FilesMatch "^(bootstrap\.php|setup\.php|connect\.php|selftest.*\.php|error_log|\.ht)|\.(log|sql|zip|bak|ini|env)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Cache-Control "no-store"
</IfModule>
